rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test document connection verification
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles: each user can read and manage their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /wishlist/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Customer orders
    match /orders/{orderId} {
      // Anyone can create an order during checkout
      allow create: if true;
      // Users can read their own orders; admins or order creators can view
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || true;
      // Updates only by admin or order owner
      allow update, delete: if request.auth != null;
    }
  }
}
